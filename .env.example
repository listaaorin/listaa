# Copy this file to .env and fill in your values
# These are PUBLIC keys (safe to include in the app bundle)

# Supabase — get from https://supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic Claude API — get from https://console.anthropic.com
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-key-here
